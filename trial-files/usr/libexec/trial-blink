#!/bin/sh
# Trial-only liveness beacon (ci-build-repo/trial-files).
#
# There is no serial console on this unit, so "the RAM image reached userspace" has to
# be visible from outside. The network cannot witness that - it is one of the things
# under test - and neither can a reboot (the reset may not reach the chip, and the
# RTL8226 keeps its link across a SoC reset anyway). The panel LEDs are the one signal
# that needs nothing but a kernel that got this far.
#
# Two independent routes to a panel LED are driven here on purpose:
#   * /sys/class/leds/<name>/brightness - depends on LEDS_GPIO plus the LED node in the
#     board DTS being right;
#   * /sys/class/gpio/export - depends on CONFIG_GPIO_SYSFS and, more usefully for
#     reading rather than driving, on the pin not already being claimed by gpio-leds
#     (see phase 3).
# Either one alone would turn a config detail into a silent, wasted round.
#
# The pin numbers below are not a guess off the stock DTB: they are the vendor kernel's
# own claim list, read from /sys/kernel/debug/gpio on the running unit, which names the
# GPIO each LED holds -
#   gpio-9  led_los      gpio-10 led_power   gpio-13 led_wps     (10d10000 = &gpio0)
#   gpio-21 led_usb1     gpio-24 led_wan                         (10d10040 = &gpio1)
#   gpio-35 led_phone1                                          (10d10080 = &gpio2)
#   gpio-63 led_pon                                             (10d100c0 = &gpio3)
#   gpio-65 led_wlan                                            (10d10100 = &gpio4)
# and the same list shows what is *not* there: led_lan0..lan3 claim no GPIO at all, so
# those four LEDs are driven by the 9132 switch's own LED outputs, which mainline has no
# driver for. Expect the LAN LEDs to stay dark under mainline - that is a missing
# feature of this SoC's mainline support, not a failed boot.
#
# Polarity is settled and still not depended upon: writing to the vendor's own LED class
# pulls each of these eight pins to "out lo" and lights the matching lamp, so they are
# active-low exactly as the stock DTB's flag cell (0x01) says. Every phase below is
# nevertheless a train of alternating halves, because a blink is the signal and a hold is
# not - and led_lan0..lan3 are deliberately absent, since the vendor drives those four
# through the SoC's LED engine (they light up without holding any GPIO) and mainline has
# no driver for it. Expect the four LAN lamps to stay dark.
#
# mainline numbers: the five controllers are 16+16+16+16+6 wide in the same address
# order, so their bases are 0/16/32/48/64 and these global numbers are the same as the
# vendor's. They are still recomputed from /sys/class/gpio/gpiochip* rather than assumed.

pins="10 9 13 21 24 35 63 65"
alive_pin=10
blinks=${1:-3}

kmsg() { echo "trial-blink: $*" >/dev/kmsg 2>/dev/null; }

have_gpio=0
[ -w /sys/class/gpio/export ] && have_gpio=1

leds=""
for l in /sys/class/leds/*; do
	[ -d "$l" ] || continue
	leds="$l ${l#/sys/class/leds/}"
done

led_max() { [ -r "$1/max_brightness" ] && cat "$1/max_brightness" || echo 255; }
led_on() { [ -w "$1/brightness" ] && echo "$(led_max "$1")" >"$1/brightness" 2>/dev/null; }
led_off() { [ -w "$1/brightness" ] && echo 0 >"$1/brightness" 2>/dev/null; }

# pulse_led <dev>
pulse_led() {
	led_on "$1"
	sleep 0.6
	led_off "$1"
	sleep 0.6
}

# pulse_gpio <global pin> <on s> <off s>
pulse_gpio() {
	n=$1
	echo "$n" >/sys/class/gpio/export 2>/dev/null || return 0
	echo out >/sys/class/gpio/gpio"$n"/direction 2>/dev/null
	echo 0 >/sys/class/gpio/gpio"$n"/value 2>/dev/null
	sleep 0.6
	echo 1 >/sys/class/gpio/gpio"$n"/value 2>/dev/null
	sleep 0.6
	echo "$n" >/sys/class/gpio/unexport 2>/dev/null
}

# power_led - the one device every phase of "alive" should use, by either route
set -- $leds
power=$1
while [ $# -gt 0 ]; do
	case "$2" in
	*power*) power=$1; break ;;
	esac
	shift 2
done

kmsg "start uptime=$(cut -d' ' -f1 /proc/uptime) gpio=$have_gpio blinks=$blinks leds=$(echo $leds | sed 's|/sys/class/leds/||g')"

# 1) "alive": the power LED, slow unmistakable blinks, before anything else.
i=0
while [ $i -lt "$blinks" ]; do
	i=$((i + 1))
	[ -n "$power" ] && pulse_led "$power"
	[ -z "$power" ] && [ "$have_gpio" = 1 ] && pulse_gpio "$alive_pin"
	sleep 0.4
done
sleep 1

# 2) all LEDs at once, three times - the signal that does not need the observer to
#    notice one small green dot.
#
#    Except the red LOS lamp.  It is not a beacon: it means "no optical
#    signal".  The NPPT driver owns it (docs/91) and the owner reads the panel
#    for the PON state, so a beacon that blinks it turns that statement into a
#    lie - and the owner reported exactly that: the red lamp dark in the
#    kernel, lit in the loader, with nothing wrong in between.  The green
#    lamps still blink, so "userspace is alive" stays readable.
if [ -n "$leds" ]; then
	i=0
	while [ $i -lt 3 ]; do
		i=$((i + 1))
		set -- $leds
		while [ $# -gt 0 ]; do
			case "$2" in
			*los*) shift 2; continue ;;
			esac
			led_on "$1"
			shift 2
		done
		sleep 0.8
		set -- $leds
		while [ $# -gt 0 ]; do
			case "$2" in
			*los*) shift 2; continue ;;
			esac
			led_off "$1"
			shift 2
		done
		sleep 0.6
	done
	sleep 1
fi

# 3) one LED per raw pin, in the order of the vendor's claim list, so the observer can
#    report which silkscreen lit at which position. This route is independent of the
#    board DTS: it proves the GPIO numbers themselves.
#
# Only when the image registered no LED devices at all: gpio-leds holds its own pins, so
# exporting one it owns answers EBUSY, and a busy export is invisible here by design
# (2>/dev/null) - which would make this walk look like "no LED at that pin" when it
# really means "the DTS already owns it". Phase 4 covers that case, named.
if [ "$have_gpio" = 1 ] && [ -z "$leds" ]; then
	for n in $pins; do
		kmsg "pin $n"
		echo "$n" >/sys/class/gpio/export 2>/dev/null
		echo out >/sys/class/gpio/gpio"$n"/direction 2>/dev/null
		i=0
		while [ $i -lt 3 ]; do
			i=$((i + 1))
			echo 0 >/sys/class/gpio/gpio"$n"/value 2>/dev/null
			sleep 2
			echo 1 >/sys/class/gpio/gpio"$n"/value 2>/dev/null
			sleep 0.6
		done
		echo "$n" >/sys/class/gpio/unexport 2>/dev/null
	done
fi

# 4) the same walk over the image's own LED devices, named, so a wrong pin in the DTS
#    shows up as a dark silkscreen next to a kmsg line that claims it lit.
#
# Three long-short pulses per device rather than one long hold: a train is harder to miss
# than a dim hold, and if the DTS names the wrong pin the observer still gets a positive
# statement - "the lamp that flashed is not the one you said" - rather than an absence.
set -- $leds
while [ $# -gt 0 ]; do
	# The LOS lamp is skipped here too, for the reason given in phase 2.
	case "$2" in
	*los*) shift 2; continue ;;
	esac
	kmsg "led $2"
	i=0
	while [ $i -lt 3 ]; do
		i=$((i + 1))
		led_on "$1"
		sleep 2
		led_off "$1"
		sleep 0.6
	done
	shift 2
done

kmsg done

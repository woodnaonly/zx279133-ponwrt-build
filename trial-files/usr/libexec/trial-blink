#!/bin/sh
# Trial-only liveness beacon (ci-build-repo/trial-files).
#
# There is no serial console on this unit, so "the RAM image reached userspace" has to
# be visible from outside. The network is not a usable witness for that - it is itself
# one of the things under test - and neither is a reboot (the reset can fail to reach
# the chip, and the PHY keeps its link across a SoC reset anyway). The panel LEDs are
# the one signal that depends on nothing but the kernel getting this far.
#
#	pass 1: every LED flashes together, $1 times  => "alive", countable
#	pass 2: each LED on its own for 3 s          => which silkscreen is which GPIO,
#	                                            which is what board.d/01_leds needs
#	fallback: no /sys/class/leds at all (wrong LED pins in the DTS, or leds-gpio did
#	not probe) => pulse raw pins through /sys/class/gpio, which is why
#	CONFIG_GPIO_CDEV_V1 is appended to the target config by CI.

cycles=${1:-3}
leds=$(ls -d /sys/class/leds/* 2>/dev/null)

echo "trial-blink: start uptime=$(cut -d' ' -f1 /proc/uptime) leds=${leds:-none}" >/dev/kmsg 2>/dev/null

if [ -n "$leds" ]; then
	i=0
	while [ $i -lt "$cycles" ]; do
		i=$((i + 1))
		for l in $leds; do
			[ -w "$l/brightness" ] || continue
			echo 255 >"$l/brightness" 2>/dev/null
		done
		sleep 0.7
		for l in $leds; do
			[ -w "$l/brightness" ] || continue
			echo 0 >"$l/brightness" 2>/dev/null
		done
		sleep 0.7
	done
	sleep 2
	n=0
	for l in $leds; do
		n=$((n + 1))
		echo "trial-blink: led $n ${l#/sys/class/leds/}" >/dev/kmsg 2>/dev/null
		echo 255 >"$l/brightness" 2>/dev/null
		sleep 3
		echo 0 >"$l/brightness" 2>/dev/null
		sleep 1
	done
	exit 0
fi

# No LED devices at all: fall back to pin-level pulses. Which chip has which base is
# not known here, so every pin of every chip is walked; the second the panel shows
# anything, userspace is proven, and the number that lit it is derivable from the
# elapsed time (0.5 s per pin, chip by chip).
[ -w /sys/class/gpio/export ] || { echo "trial-blink: no leds, no gpio sysfs" >/dev/kmsg 2>/dev/null; exit 0; }
for chip in /sys/class/gpio/gpiochip*; do
	[ -d "$chip" ] || continue
	base=$(cat "$chip/base" 2>/dev/null)
	ng=$(cat "$chip/ngpio" 2>/dev/null)
	echo "trial-blink: gpiochip ${chip#/sys/class/gpio/} base=$base ngpio=$ng" >/dev/kmsg 2>/dev/null
	p=0
	while [ $p -lt "$ng" ]; do
		n=$((base + p))
		if echo "$n" >/sys/class/gpio/export 2>/dev/null; then
			echo out >/sys/class/gpio/gpio"$n"/direction 2>/dev/null
			echo 1 >/sys/class/gpio/gpio"$n"/value 2>/dev/null
			sleep 0.5
			echo 0 >/sys/class/gpio/gpio"$n"/value 2>/dev/null
			echo "$n" >/sys/class/gpio/unexport 2>/dev/null
		fi
		p=$((p + 1))
	done
done

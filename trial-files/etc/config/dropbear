# See https://openwrt.org/docs/guide-user/base-system/dropbear
#
# Trial-only: the stock file binds the listener to the `lan` interface, so if the
# address lands on a netdev the image did not expect, ssh never starts and the
# round says nothing. Unbound, it listens wherever this RAM image has an address.
config dropbear main
	option enable '1'
	option PasswordAuth 'on'
	option RootPasswordAuth 'on'
	option Port         '22'

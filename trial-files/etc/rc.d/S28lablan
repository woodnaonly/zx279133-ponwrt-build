#!/bin/sh
# Trial-only: let a client in any jack reach the ONT behind another jack.
#
# WHY THIS SCRIPT EXISTS
#
# The 9132's switch engine does not carry a frame from one UNI port to
# another.  That is not a guess - it was measured twice on 2026-10-29:
#
#   * a client in the 2.5G jack reaches a client inside the bridge's own
#     veth port (so a broadcast does get in, and the board's CPU sees it),
#     but the same client does not reach the ONT in another jack;
#   * the same client, with a static ARP entry that points 192.168.1.1
#     straight at the ONT's own MAC address, still loses every packet.
#     Nothing of the board's is involved in that path, and it still fails,
#     so the chip itself does not forward from one jack to another.
#
# So the board has to do the forwarding itself, and that takes four things:
#
#   1. an address in the ONT's subnet on the bridge, plus the kernel's
#      proxy ARP, so that the board answers the client's "who has the ONT".
#      The kernel's proxy ARP only answers when the route to the address
#      it is asked about leaves through a device other than the one the
#      request arrived on, which is why the route below is a /32 and not
#      the subnet;
#   2. that /32 route for the ONT, out of the ONT's own jack.  It has the
#      same requirement, and it also stops the kernel from calling the
#      packet a hairpin: it refuses to forward a packet out of the
#      interface it came in on, and before this route the board's
#      ForwDatagrams stayed at 0 while the client's packets were arriving
#      (docs/92 §96.36);
#   3. the ONT's MAC pinned on that jack.  The board cannot ARP for it
#      there: a frame the DSA layer sends out of a user port carries the
#      transport tag, and the ONT does not answer a tagged ARP - which is
#      why the MAC is learned through the bridge instead, where the same
#      question is asked with an untagged frame;
#   4. a route for every client in the ONT's subnet, out of the jack it
#      is in, or the ONT's reply cannot be handed back to it.  The reply
#      comes back to the board (the ONT learned the client's address from
#      the board's own MAC, because the board's proxy ARP answered the
#      ONT's ARP request), and the board has to give it to the client
#      through the client's own jack;
#   5. the client's MAC pinned on that jack as well, for the same reason:
#      without the pin the board has to ask for it, and an ARP request
#      the DSA layer sends out of a user port is tagged, and the client
#      does not answer that either.
#
# WHAT THIS SCRIPT DELIBERATELY DOES NOT DO
#
# It does not masquerade the traffic towards the ONT.  With the
# masquerade in place the ONT does answer - the board sees the reply in
# its own connection tracking - but the reply arrives at the client's
# network card with a checksum the client's stack rejects, and the
# client never sees it.  Without it the ONT sees the client's own
# address, and the reply comes back with a checksum the client accepts
# (measured on 2026-10-29: 5/5 replies, 1-2 ms, TTL 63).
#
# It does not touch a single chip register either: the untag SVID and
# the LAN TX output port were both set to their defaults again and the
# traffic still went through.
#
# WHICH JACK A CLIENT IS IN
#
# The bridge's forwarding database says which port learned a MAC, but that
# port is the bridge's own number, not a device name.  The kernel states
# the mapping itself, every time a port joins or leaves the bridge:
#
#	br-lan: port 5(lan5) entered forwarding state
#
# and that mapping survives a port leaving and coming back - the number
# belongs to the port, and the port keeps it.  So the numbers are read
# out of the kernel's own log, and the fallback - the DSA jack of the same
# number, which is what the numbers are on this board - is only used when
# the log does not say.
#
# The client gets its address in the ONT's subnet from the image's own
# dnsmasq, so a client that asks for a lease gets one and needs no
# setting at all.  That range has to come FIRST: dnsmasq hands out an
# address from the first range that fits, and a client that arrives
# without an address gets the first one, so a range that comes second is
# a range that is never used.
#
# /etc/labont names the ONT.  Everything in it is optional:
#
#	ont=192.168.1.1	the ONT's address
#	ontport=lan4		the jack the ONT is in
#	ontmac=			leave empty to learn it
#
# The work is done by a script of its own, in the background: the init
# system waits for this one, and a script that never returns is a script
# that stops everything behind it from starting.  setsid gives that child
# a session of its own, which is what nohup was standing in for - and
# nohup is not in this image: the busybox here has no nohup applet.

cat > /tmp/lablan.sh <<'LABEOF'
#!/bin/sh
ONT=192.168.1.1
ONTPORT=lan4
ONTMAC=""
ONTNET=""
BRIDGE=br-lan

if [ -f /etc/labont ]; then
	. /etc/labont
fi
[ -n "$ONT" ] || exit 0

# The subnet the ONT is in.  The clients get their addresses from it, and
# it has to be the ONT's own subnet: a client in another subnet cannot
# reach the ONT.  The reason is not a matter of taste - the ONT's answer
# comes back to the board, the board hands it to the client, and by then
# its source address is the client's own address again (that is what the
# translation does), and a client's own stack drops a packet that claims
# to come from itself (RFC 1122 3.2.1.3).  Measured on 2026-10-29: with
# the translation in place the answer reached the client's card and the
# client threw it away.
#
# So the way to move the clients out of a subnet is to move the ONT out of
# it as well, and to write the new subnet down here.
BASE=${ONTNET:-${ONT%.*}}

say() {
	echo "trial: lablan: $*" >/dev/kmsg
}

# The device name of a bridge port number, as the kernel states it.
#
# The name that comes first is not always the right one: the CPU port
# carries a number of its own and is not a member of the bridge, so only
# the names that really are in the bridge are taken.
dev_of_port() {
	p=$1
	d=""
	if [ -s /tmp/lablan-ports ]; then
		d=$(awk -v p="$p" '$1 == p {print $2; exit}' /tmp/lablan-ports)
	fi
	if [ -z "$d" ] && [ -e "/sys/class/net/lan$p" ]; then
		d="lan$p"
	fi
	echo "$d"
}

# The route and the pin for one client in the ONT's subnet.
pin_client() {
	ip=$1
	mac=$2
	case "$mac" in
	??:??:??:??:??:??) ;;
	*) return 0 ;;
	esac
	dev=$(awk -v mac="$mac" '$1 == mac {print $2; exit}' /tmp/lablan-fdb)
	[ -n "$dev" ] || return 0
	# The pin comes first: the board must not have to ask for the MAC,
	# because the frames it sends out of a user port are tagged and the
	# client does not answer a tagged ARP.
	ip neigh replace "$ip" lladdr "$mac" nud permanent dev "$dev" 2>/dev/null
	ip route replace "$ip"/32 dev "$dev" 2>/dev/null
	# The log is where the round's evidence lives, so it is written to
	# when something changes and not on every round.
	line="$ip $mac $dev"
	grep -q "^$line$" /tmp/lablan-clients.old 2>/dev/null ||
		say "$ip ($mac) is in $dev"
	echo "$line" >> /tmp/lablan-clients
}

# A route for every client in the ONT's subnet, out of the jack it is in,
# and the client's MAC pinned on that same jack.
refresh_clients() {
	: > /tmp/lablan-clients
	# The bridge's port numbers, as the kernel states them.  This is
	# read once per round: the log is the only place the kernel says
	# which number belongs to which jack, and reading it for every
	# learned address would be a lot of reading for nothing.
	: > /tmp/lablan-ports
	if command -v dmesg >/dev/null 2>&1; then
		dmesg 2>/dev/null |
		sed -n 's/.*br-lan: port \([0-9][0-9]*\)(\([^)]*\)).*/\1 \2/p' |
		while read p n; do
			[ -e "/sys/class/net/$BRIDGE/brif/$n" ] || continue
			echo "$p $n" >> /tmp/lablan-ports
		done
	fi
	# The MAC of every learned address, and the jack it was learned on.
	brctl showmacs "$BRIDGE" 2>/dev/null |
	while read port mac rest; do
		case "$mac" in
		??:??:??:??:??:??) ;;
		*) continue ;;
		esac
		dev=$(dev_of_port "$port")
		[ -n "$dev" ] || continue
		echo "$mac $dev"
	done > /tmp/lablan-fdb

	# The clients the DHCP server has handed an address to.  The lease
	# file is the reliable source: it has both the address and the MAC
	# in it, while the bridge's neighbour table only knows an address
	# once somebody has asked for it - and nobody has, unless the ONT
	# has.
	if [ -s /tmp/dnsmasq.leases ]; then
		awk '{print $3, $2}' /tmp/dnsmasq.leases |
		while read ip mac; do
			case "$ip" in
			"$BASE".*) ;;
			*) continue ;;
			esac
			[ -n "$mac" ] || continue
			pin_client "$ip" "$mac"
		done
	fi

	# And the clients that have an address of their own.
	ip neigh show dev "$BRIDGE" 2>/dev/null |
	while read ip ll mac state rest; do
		case "$ip" in
		"$BASE".*) ;;
		*) continue ;;
		esac
		[ -n "$mac" ] || continue
		pin_client "$ip" "$mac"
	done

	# The pins of clients that are gone are of no use to anybody and
	# would keep a stale address on a jack for ever.  Only the pins on
	# a jack are touched: the ones on the bridge are the kernel's own
	# business, and they are there for the proxy ARP to work.
	ip neigh show nud permanent 2>/dev/null |
	while read ip dev ll mac state rest; do
		case "$ip" in
		"$BASE".*) ;;
		*) continue ;;
		esac
		[ "$ip" = "$ONT" ] && continue
		[ "$dev" = "$BRIDGE" ] && continue
		grep -q "^$ip " /tmp/lablan-clients 2>/dev/null && continue
		ip neigh del "$ip" dev "$dev" nud permanent 2>/dev/null
		say "the pin of $ip is gone"
	done

	# This round's list becomes the next round's reference.
	cp /tmp/lablan-clients /tmp/lablan-clients.old 2>/dev/null
}

# netifd builds the bridge a moment after the network init returns.
i=0
while [ $i -lt 30 ]; do
	[ -e "/sys/class/net/$BRIDGE" ] && break
	i=$((i + 1))
	sleep 1
done
[ -e "/sys/class/net/$BRIDGE" ] || {
	say "there is no $BRIDGE"
	exit 0
}

# The ONT's jack has to be in the bridge: a jack that is out of it is a
# routed port, and the ONT behind it answers DHCP - which is how the
# watcher in S26nat took this very jack for the WAN on 2026-10-29 and
# left the board without a bridge at all.
ip link set "$ONTPORT" master "$BRIDGE" 2>/dev/null
ip link set "$ONTPORT" up 2>/dev/null

# The board's own address in the ONT's subnet: the proxy ARP answers for
# addresses in a subnet the board is in.
#
# The address is written down as well as being put on the bridge, because
# the DHCP range is computed from the network configuration (see the
# dnsmasq part below).  And the network is reloaded right here, before
# anything is pinned: a reload rebuilds the bridge, and everything that
# was pinned on it is gone with it.
if command -v uci >/dev/null 2>&1; then
	uci set network.lan.ipaddr="$BASE.100/24" 2>/dev/null
	uci commit network 2>/dev/null
	/etc/init.d/network reload >/dev/kmsg 2>&1
	# The reload takes a moment, and the bridge is rebuilt in it.
	i=0
	while [ $i -lt 20 ]; do
		[ -e "/sys/class/net/$BRIDGE" ] && break
		i=$((i + 1))
		sleep 1
	done
fi
ip addr replace "$BASE.100/24" dev "$BRIDGE" 2>/dev/null

# The ONT's MAC, learned through the bridge.  This has to happen before
# the /32 route below is in place: with that route the ARP would leave
# through the ONT's own jack, and the DSA layer tags the frames it sends
# out of a user port, and the ONT does not answer a tagged ARP.  Through
# the bridge the same question is asked from the CPU port, which is
# untagged, and the ONT answers.
if [ -z "$ONTMAC" ]; then
	ip neigh flush dev "$BRIDGE" 2>/dev/null
	ping -c 1 -W 1 "$ONT" >/dev/null 2>&1
	ONTMAC=$(ip neigh show dev "$BRIDGE" 2>/dev/null |
		awk -v ip="$ONT" '$1 == ip {print $3}')
fi
if [ -n "$ONTMAC" ]; then
	ip neigh replace "$ONT" lladdr "$ONTMAC" nud permanent dev "$ONTPORT" 2>/dev/null
	say "the ONT is $ONT ($ONTMAC) on $ONTPORT"
else
	say "the ONT has no MAC yet; it will be learned"
fi

# The ONT's route, out of its own jack.  It is also what makes the proxy
# ARP answer, and what stops the kernel from calling the packet a
# hairpin.
ip route replace "$ONT"/32 dev "$ONTPORT" 2>/dev/null

# The proxy ARP itself, on the bridge and everywhere.
echo 1 > "/proc/sys/net/ipv4/conf/$BRIDGE/proxy_arp" 2>/dev/null
echo 1 > /proc/sys/net/ipv4/conf/all/proxy_arp 2>/dev/null

# The image's own dnsmasq has to hand out an address in the ONT's subnet,
# or a client that asks for a lease gets one in the board's subnet and
# cannot reach the ONT at all.
#
# The configuration is written through UCI and the image's own init script,
# and not through a dnsmasq of our own:
#
#   * S26nat has already started a dnsmasq, and a second one cannot have
#     the DHCP socket - it dies with "failed to bind DHCP server socket:
#     Address in use" (measured on 2026-10-29 22:00), and the check that
#     was supposed to notice that ("pidof dnsmasq") sees the *old* process,
#     which is still alive, so it reports success.  The clients then get
#     nothing and the log says the ranges are served.
#   * the process the image runs is the one procd knows about, so it is
#     the one that survives, and its configuration is the one that is
#     written down.
#
# Three things about this image's dnsmasq init script (S19dnsmasq) decide
# how the range has to be written, and all three were measured on
# 2026-10-29 22:02 - 22:09:
#
#   1. the DHCP section's "interface" is a *network* name, not a device
#      name.  With "br-lan" the section is skipped silently and the
#      generated configuration has no dhcp-range at all: the script asks
#      the network configuration for the device behind the name, and
#      there is no network called "br-lan".
#   2. the section needs "force 1".  Without it the script checks whether
#      a DHCP server is already running on that interface - and one is:
#      the ONT answers DHCP on the jack that is in the same bridge.  So
#      the range is refused with "found already running DHCP-server on
#      interface 'br-lan'".
#   3. the range is computed from the *network's* address, not from the
#      section: the script takes network.lan's ipaddr and adds the
#      section's "start" and "limit" to it.  So the range only comes out
#      in the ONT's subnet if network.lan's address is in the ONT's
#      subnet - which is what the board's own address has to be anyway.
#
# The board's address is therefore changed here: network.lan gets the
# ONT's subnet, and the address the bridge already carries is the same
# one, so nothing moves.
if command -v uci >/dev/null 2>&1; then
	# The DHCP section.  "lan" is the network name (see 1 above).
	uci set dhcp.lan="dhcp" 2>/dev/null
	uci set dhcp.lan.interface="lan" 2>/dev/null
	uci set dhcp.lan.start="101" 2>/dev/null
	uci set dhcp.lan.limit="100" 2>/dev/null
	uci set dhcp.lan.leasetime="12h" 2>/dev/null
	# force 1 (see 2 above): the ONT answers DHCP on a jack of the same
	# bridge, and without this the range is refused.
	uci set dhcp.lan.force="1" 2>/dev/null
	# The gateway is the board itself, in the ONT's subnet.
	uci -q delete dhcp.lan.dhcp_option 2>/dev/null
	uci add_list dhcp.lan.dhcp_option="3,$BASE.100" 2>/dev/null
	uci add_list dhcp.lan.dhcp_option="6,$BASE.100" 2>/dev/null
	# The lease file is where the clients' addresses and MACs are read
	# from, and it has to be the one the image's dnsmasq writes.
	uci set dhcp.@dnsmasq[0].leasefile="/tmp/dnsmasq.leases" 2>/dev/null
	uci commit dhcp 2>/dev/null

	# The server is restarted through the image's own init script, so
	# there is exactly one dnsmasq and procd knows which one it is.
	/etc/init.d/dnsmasq restart >/dev/kmsg 2>&1
	sleep 3
	pidof dnsmasq >/dev/null 2>&1 ||
		say "dnsmasq did not start; the clients will get no lease"
	# The range that is really in the generated configuration is what
	# matters, and it is read back rather than assumed.
	if grep -qs "dhcp-range=.*$BASE.101" /var/etc/dnsmasq.conf.* 2>/dev/null; then
		say "dnsmasq serves $BASE.101-$BASE.200"
	else
		say "dnsmasq does not serve $BASE.0/24; the clients will get no lease"
	fi
fi

# The bridge's own port numbers, as the kernel states them.  It is
# printed so that the round's evidence says which jack is which.
for p in 1 2 3 4 5 6 7 8; do
	d=$(dev_of_port "$p")
	[ -n "$d" ] && say "bridge port $p is $d"
done

# The clients are given addresses in the ONT's own subnet, and a machine
# that has two of them - a wired one in that subnet and a wireless one in
# it as well - has two routes to the same destination and picks one of
# them by metric, not by where the ONT is.
say "the clients will be in $BASE.0/24; a client that also has a wireless link in that subnet has two of them, and the route to the ONT goes to whichever one the metric picks"

refresh_clients
# Every five seconds, not every minute: a client that has just taken a
# lease asks for the ONT at once, and the answer cannot reach it until
# its MAC is pinned - so the pin has to keep up with the client.
while true; do
	sleep 5
	refresh_clients
done
LABEOF

chmod 755 /tmp/lablan.sh
setsid /tmp/lablan.sh >/dev/kmsg 2>&1 &

exit 0

// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
// Skyworth SK-D840N (GPON ONU, Sanechips/ZTE ZX279133) board tree for the
// cnjn mainline 6.18.38 zte/zx279133 target.
//
// Facts taken from this unit, not guessed:
//   - SPI-NAND hangs off the SFC at 0x10d0f000 (live: /sys/.../10d0f000.spifc/spi_master/spi1/spi1.0)
//   - partition map is the community U-Boot one (env at boot+0x180000):
//       boot 2048k@0x0 kernel 8192k@0x200000 dtb 1024k@0xa00000
//       "parameter tags" 4096k@0xb00000 root 246784k@0xf00000
//     fixed-partitions registration order below therefore yields
//     mtd0=boot mtd1=kernel mtd2=dtb mtd3="parameter tags" mtd4=root.
//   - console is the PL011-compatible zte,zx279133-uart at 0x10d0d000, 115200n8
//   - memory is 512 MiB at 0x80000000 (stock DTB: reg = <0x0 0x80000000 0x0 0x20000000>)
//
// OPEN ITEMS (deliberately copied from the validated SR1010 board file, to be
// re-probed on this unit before the image is ever flashed):
//   * SK-D840N's four LAN ports are behind the SoC-internal "9132" UNI switch
//     (vendor np_133.ko / switch.ko; stock DTB lists uni-phy = <0x0a 0x0b 0x0c
//     0x0d 0x05 0x1c 0x02> on mdio0/mdio1). There is no mainline driver for it,
//     so the RTL8372N DSA node of SR1010 is dropped here.
//   * the 2.5G PHY part on this board is not confirmed (vendor module is
//     rlt8226b.ko, cnjn's tree drives ZX279051); kept as zx279051 for now.
//   * MAC address: the ZTE "parameter tags" nvmem layout of SR1010 does not
//     apply, so the stock ePHY MAC is written literally. Replace with an
//     nvmem cell once the tags parser for this SKU is known.

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "zx279133.dtsi"

/ {
	model = "Skyworth SK-D840N";
	compatible = "skyworth,sk-d840n", "zte,zx279133";

	aliases {
		serial0 = &uart0;
		watchdog0 = &watchdog0;
		watchdog1 = &watchdog1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		se_hash_reserved: buffer@9e100000 {
			reg = <0x0 0x9e100000 0x0 0x1000000>;
			no-map;
		};

		idm_reserved: buffer@9d700000 {
			reg = <0x0 0x9d700000 0x0 0xa00000>;
			no-map;
		};

		bmu_reserved: buffer@9f100000 {
			reg = <0x0 0x9f100000 0x0 0x0f00000>;
			no-map;
		};
	};

	thermal-zones {
		soc-thermal {
			thermal-sensors = <&pvt>;
		};
	};
};

&uart0 {
	status = "okay";
};

&pvt {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&pon_serdes {
	status = "okay";
};

&uni_serdes {
	status = "okay";
};

&nppt {
	memory-region = <&bmu_reserved>, <&se_hash_reserved>, <&idm_reserved>;
	memory-region-names = "bmu", "se-hash", "idm";
	phy-handle = <&zx279051>;
	/* D0:45:8D:84:08:FC = ethaddr from the stock "others" partition */
	local-mac-address = [00 00 00 00 00 00];
	status = "okay";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	zx279051: ethernet-phy@1 {
		compatible = "ethernet-phy-id0000.84b9";
		reg = <1>;
		max-speed = <2500>;
	};
};

&xpcs0 {
	status = "okay";
};

&xpcs1 {
	status = "okay";
};

&watchdog1 {
	status = "okay";
};

/* No env edit is needed to boot this image: U-Boot's bootargs say
 * `root=/dev/mtdblock5`, so the fixed-partitions list below is ordered to put
 * `root` at index 5 while keeping every partition non-overlapping.
 * `spare` (the erased tail of the community `root` region) exists only to hold
 * the index; it stays read-only. Offsets/labels mirror the community U-Boot env
 * (boot 2048k@0x0, kernel 8192k@0x200000, dtb 1024k@0xa00000,
 *  "parameter tags" 4096k@0xb00000, root 246784k@0xf00000).
 */
&spifc {
	spi-max-frequency = <25000000>;
	status = "okay";

	flash@0 {
		partitions-only;
		spi-max-frequency = <25000000>;

		/delete-node/ partitions;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x000000 0x200000>;
				read-only;
			};

			partition@200000 {
				label = "kernel";
				reg = <0x200000 0x800000>;
			};

			partition@a00000 {
				label = "dtb";
				reg = <0xa00000 0x100000>;
			};

			partition@b00000 {
				label = "parameter tags";
				reg = <0xb00000 0x400000>;
				read-only;
			};

			partition@3000000 {
				label = "spare";
				reg = <0x3000000 0xd000000>;
				read-only;
			};

			partition@f00000 {
				label = "root";
				reg = <0xf00000 0x1f10000>;
			};
		};
	};
};

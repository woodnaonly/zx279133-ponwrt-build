// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
// Skyworth SK-D840N (GPON ONU, Sanechips/ZTE ZX279133) board tree for the
// cnjn mainline 6.18.38 zte/zx279133 target.
//
// Facts taken from this unit, not guessed:
//   - SPI-NAND hangs off the SFC at 0x10d0f000 (live: /sys/.../10d0f000.spifc/spi_master/spi1/spi1.0)
//   - partition map is the community U-Boot one (env at boot+0x180000):
//       boot 2048k@0x0 kernel 8192k@0x200000 dtb 1024k@0xa00000
//       "parameter tags" 4096k@0xb00000 root 246784k@0xf00000
//     fixed-partitions registration order below therefore yields
//     mtd0=boot mtd1=kernel mtd2=dtb mtd3="parameter tags" mtd4=scratch mtd5=root.
//     (`root` must stay index 5 - that is what the installed U-Boot bootargs
//      hard-code as root=/dev/mtdblock5, so exactly five partitions precede it.
//      The U-Boot env still calls the 241 MiB region at 0xf00000 `root`, but its
//      bootcmd only ever reads `kernel` and `dtb`, so moving root to 0x1000000
//      costs nothing and leaves the first erase blocks of the old jffs2 intact.)
//   - console is the PL011-compatible zte,zx279133-uart at 0x10d0d000, 115200n8
//   - memory is 512 MiB at 0x80000000 (stock DTB: reg = <0x0 0x80000000 0x0 0x20000000>)
//
// OPEN ITEMS (deliberately copied from the validated SR1010 board file, to be
// re-probed on this unit before the image is ever flashed):
//   * Only the RTL8226 port below is reachable in mainline. The four GE LAN ports
//     sit behind the SoC-internal "9132" UNI switch, which the vendor drives
//     without phylib or DSA at all - the running system shows it:
//     /dev/ethdriver + "ethdrv_dev_ioctl brdev_set.port_id 1, name eth1" for
//     eth0..eth3, and /sys/bus/mdio_bus/devices is empty. There is no mainline
//     equivalent, so SR1010's RTL8372N DSA node is dropped and the LAN-side
//     zte,zx279133-lan-conduit child is left out too (it is the CPU port of an
//     external switch this board does not have).
//     This unit has **no WAN/uplink jack at all** - the front panel is 4x LAN plus
//     the fibre PON - so eth0 (NPPT + RTL8226) is one of those four LAN jacks, and
//     the running image only calls it `wan` because the community config came from
//     a router default (lan bridge = eth1 eth2 eth3, wan.device = eth0). Which jack
//     it is can be read straight off the vendor driver, which logs the port number
//     per netdev: `[eth0] port 4 link up` / `[eth1] port 1 link up:1000M`, i.e.
//     move a cable and watch dmesg. Anyone testing over the wire has to be in
//     *that* jack, because no LAN port driven by the 9132 exists in mainline.
//   * MAC address: the ZTE "parameter tags" nvmem layout of SR1010 does not
//     apply, so no MAC source is given; see the comment on &nppt.

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "zx279133.dtsi"

/ {
	model = "Skyworth SK-D840N";
	compatible = "skyworth,sk-d840n", "zte,zx279133";

	aliases {
		serial0 = &uart0;
		watchdog0 = &watchdog0;
		watchdog1 = &watchdog1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		se_hash_reserved: buffer@9e100000 {
			reg = <0x0 0x9e100000 0x0 0x1000000>;
			no-map;
		};

		idm_reserved: buffer@9d700000 {
			reg = <0x0 0x9d700000 0x0 0xa00000>;
			no-map;
		};

		bmu_reserved: buffer@9f100000 {
			reg = <0x0 0x9f100000 0x0 0x0f00000>;
			no-map;
		};
	};

	thermal-zones {
		soc-thermal {
			thermal-sensors = <&pvt>;
		};
	};
};

&uart0 {
	status = "okay";
};

&pvt {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&pon_serdes {
	status = "okay";
};

&uni_serdes {
	status = "okay";
};

&nppt {
	memory-region = <&bmu_reserved>, <&se_hash_reserved>, <&idm_reserved>;
	memory-region-names = "bmu", "se-hash", "idm";
	phy-handle = <&zx279051>;
	/* No MAC source yet: SR1010 reads it from an nvmem-layout over its own
	 * "tags" partition, whose zte,sr1010-tags parser does not describe this
	 * unit's "parameter tags" layout. With neither nvmem-cells nor a literal
	 * local-mac-address the driver falls back to a generated random MAC, which
	 * is usable for the trial - hardcoding D0:45:8D:84:08:FC would only be
	 * right for this one board.
	 */
	status = "okay";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	/* The one external PHY on this board. Evidence from the running unit:
	 *  - dmesg: 14f01000.mdio "mdio not set pins" (internal-only bus, it carries
	 *    the four 9132 UNI PHYs at 0x0a..0x0d), 14f02000.mdio has pinctrl -> the
	 *    bus with external PHYs.
	 *  - stock bdinfo: outerphy_desc_name = "phy_RTL8226",
	 *    outerphy_desc_mode = <0x00 0x05 0x00>, and mdio1's uni-phy list contains
	 *    0x05 -> address 5, where SR1010 has its PHY at address 1.
	 * The id-compatible is tried first, genphy-ieee802.3-c22 is the fallback so a
	 * different PHY id still yields an attached (1G) PHY instead of nothing.
	 */
	zx279051: ethernet-phy@5 {
		compatible = "ethernet-phy-id0000.84b9", "ethernet-phy-ieee802.3-c22";
		reg = <5>;
		max-speed = <2500>;
		/* stock bdinfo: phy-reset = <0x28> = global GPIO 40 = &gpio2 8 (bdinfo
		 * numbers are global: its slic-reset = <0x06> shows up in the running
		 * system as gpiochip0/gpio-6 labelled "slic-reset"). gpio-40 itself is
		 * not held by the vendor kernel, so it pulsed and released it.
		 */
		reset-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
		reset-delay-us = <10000>;
	};
};

&xpcs0 {
	status = "okay";
};

&xpcs1 {
	status = "okay";
};

/* Both watchdogs are switched off here, and that is a measured requirement, not
 * caution: zx279133.dtsi already ships watchdog0 (14f09000) as "okay" with
 * timeout-sec = <10> and zte,restart-watchdog, and nothing in a RAM-only image
 * feeds it - procd only opens /dev/watchdog when
 * system.@system[0].watchdog_timeout is set, which an initramfs never does.
 * kexec into this board's Image on the unit did switch over (the 4.19 system came
 * back 43 s later, which is only possible if the new kernel had run far enough to
 * arm a reset), so a mainline build with the watchdog left enabled reboots itself
 * roughly every 40 s - forever, once it is flashed. Re-enable either node only
 * together with a feeder in the image.
 */
&watchdog0 {
	status = "disabled";
};

&watchdog1 {
	status = "disabled";
};

/* No env edit is needed to boot this image: U-Boot's bootargs say
 * `root=/dev/mtdblock5`, so exactly five partitions must precede `root`.
 * `scratch` is the cheapest way to spend one of those indices: 1 MiB at
 * 0xf00000, which is where the community `root` partition begins, so the first
 * erase blocks of the 4.19 jffs2 stay untouched and a rollback keeps its oldest
 * nodes. `root` then starts one MiB later and gets the rest of the chip
 * (240 MiB) instead of being squeezed to make the tail fit.
 * Offsets/labels otherwise mirror the community U-Boot env
 * (boot 2048k@0x0, kernel 8192k@0x200000, dtb 1024k@0xa00000,
 *  "parameter tags" 4096k@0xb00000).
 */
&spifc {
	spi-max-frequency = <25000000>;
	status = "okay";

	flash@0 {
		partitions-only;
		spi-max-frequency = <25000000>;

		/delete-node/ partitions;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x000000 0x200000>;
				read-only;
			};

			partition@200000 {
				label = "kernel";
				reg = <0x200000 0x800000>;
			};

			partition@a00000 {
				label = "dtb";
				reg = <0xa00000 0x100000>;
			};

			partition@b00000 {
				label = "parameter tags";
				reg = <0xb00000 0x400000>;
				read-only;
			};

			/* Holds the index so `root` lands on mtdblock5. Not a usable
			 * log/scratch area in practice: a partial write needs the
			 * MEMERASE ioctl and this image has no tool that can erase a
			 * sub-partition range (/sbin/mtd erases whole partitions).
			 */
			partition@f00000 {
				label = "scratch";
				reg = <0xf00000 0x100000>;
			};

			partition@1000000 {
				label = "root";
				reg = <0x1000000 0xf000000>;
			};
		};
	};
};

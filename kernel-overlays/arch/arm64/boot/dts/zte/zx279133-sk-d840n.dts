// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
// Skyworth SK-D840N (GPON ONU, Sanechips/ZTE ZX279133) board tree for the
// cnjn mainline 6.18.38 zte/zx279133 target.
//
// Facts taken from this unit, not guessed:
//   - SPI-NAND hangs off the SFC at 0x10d0f000 (live: /sys/.../10d0f000.spifc/spi_master/spi1/spi1.0)
//   - partition map is the community U-Boot one (env at boot+0x180000):
//       boot 2048k@0x0 kernel 8192k@0x200000 dtb 1024k@0xa00000
//       "parameter tags" 4096k@0xb00000 root 246784k@0xf00000
//     The /dev/mtdN numbering is pinned by the mtd1..mtd6 aliases below, not counted off
//     node order, so it survives a kernel-config change: boot=1 kernel=2 dtb=3
//     "parameter tags"=4 root=5 scratch=6, and mtd0 is the SPI-NAND master if
//     CONFIG_MTD_PARTITIONED_MASTER is enabled and absent if it is not.
//     (`root` must stay index 5 - the installed U-Boot bootargs hard-code
//      root=/dev/mtdblock5 - *and* must start at 0xf00000, because that is where the
//      system that does the flashing puts its own `root`: the vendor 4.19 table is
//      whole/boot/kernel/dtb/param/root@0xf00000 (241 MiB), and /sbin/mtd on it can
//      only erase and write a whole partition by label. An image that satisfied one
//      constraint but not the other boots as a VFS panic with no serial to read.)
//   - console is the PL011-compatible zte,zx279133-uart at 0x10d0d000, 115200n8
//   - memory is 512 MiB at 0x80000000 (stock DTB: reg = <0x0 0x80000000 0x0 0x20000000>)
//
// OPEN ITEMS (deliberately copied from the validated SR1010 board file, to be
// re-probed on this unit before the image is ever flashed):
//   * Only the RTL8226 port below is reachable in mainline. The four GE LAN ports
//     sit behind the SoC-internal "9132" UNI switch, which the vendor drives
//     without phylib or DSA at all - the running system shows it:
//     /dev/ethdriver + "ethdrv_dev_ioctl brdev_set.port_id 1, name eth1" for
//     eth0..eth3, and /sys/bus/mdio_bus/devices is empty. There is no mainline
//     equivalent, so SR1010's RTL8372N DSA node is dropped and the LAN-side
//     zte,zx279133-lan-conduit child is left out too (it is the CPU port of an
//     external switch this board does not have).
//     This unit has **no WAN/uplink jack at all** - the front panel is 4x LAN plus
//     the fibre PON - so eth0 (NPPT + RTL8226) is one of those four LAN jacks, and
//     the running image only calls it `wan` because the community config came from
//     a router default (lan bridge = eth1 eth2 eth3, wan.device = eth0). Which jack
//     it is can be read straight off the vendor driver, which logs the port number
//     per netdev: `[eth0] port 4 link up` / `[eth1] port 1 link up:1000M`, i.e.
//     move a cable and watch dmesg. Anyone testing over the wire has to be in
//     *that* jack, because no LAN port driven by the 9132 exists in mainline.
//   * MAC address: the ZTE "parameter tags" nvmem layout of SR1010 does not
//     apply, so no MAC source is given; see the comment on &nppt.

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "zx279133.dtsi"

/ {
	model = "Skyworth SK-D840N";
	compatible = "skyworth,sk-d840n", "zte,zx279133";

	aliases {
		serial0 = &uart0;
		watchdog0 = &watchdog0;
		watchdog1 = &watchdog1;
		/* Pin the /dev/mtdN numbering (drivers/mtd/mtdcore.c add_mtd_device():
		 * `ofidx = of_alias_get_id(np, "mtd")` then idr_alloc(ofidx, ofidx+1)).
		 * Without this the numbers depend on CONFIG_MTD_PARTITIONED_MASTER, which
		 * decides whether the SPI-NAND master itself occupies mtd0 - and a wrong
		 * guess boots as a VFS panic on the wrong partition, with no serial to read.
		 */
		mtd1 = &bootpart;
		mtd2 = &kernelpart;
		mtd3 = &dtbpart;
		mtd4 = &tagspart;
		mtd5 = &rootpart;
		mtd6 = &scratchpart;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* Same string the build script pins into CONFIG_CMDLINE. It belongs here as
		 * well because the kernel's built-in-vs-bootloader precedence (FROM_BOOTLOADER,
		 * EXTEND, FORCE) is a config choice nobody is looking at, and the two spellings
		 * agreeing is what makes the root device the same in all three. mtdblock5 is
		 * pinned by the mtd5 alias below, and jffs2 is what the root partition holds.
		 */
		bootargs = "console=ttyAMA0,115200n8 root=/dev/mtdblock5 rootfstype=jffs2 ro rootwait";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		se_hash_reserved: buffer@9e100000 {
			reg = <0x0 0x9e100000 0x0 0x1000000>;
			no-map;
		};

		idm_reserved: buffer@9d700000 {
			reg = <0x0 0x9d700000 0x0 0xa00000>;
			no-map;
		};

		bmu_reserved: buffer@9f100000 {
			reg = <0x0 0x9f100000 0x0 0x0f00000>;
			no-map;
		};

		/* pstore/ramoops: the console log written here survives a *warm* reset, which is
		 * the only way this board can hand back a boot log with no serial port. The
		 * trial round that uses it does not mask CRM 0x10e10208, so the vendor's
		 * already-armed zx_wdt (8 s, fed in-kernel by 4.19) bites some tens of seconds
		 * after the jump; the reset lands back in the flashed system, which dumps this
		 * region from /dev/mem within its first seconds.
		 *
		 * The address is measured, not guessed. Markers were written at nine addresses,
		 * the board was rebooted normally, and the readback says:
		 *   0x90000000 0x94000000 0x98000000 0x9c000000 0x9d000000   survived
		 *   0x9e100000 0x9f100000 0x9fa00000 0x9ff00000              rewritten
		 * so U-Boot owns roughly the top 32 MiB and everything from 0x9d700000 up is
		 * off limits (that is also where idm/se_hash/bmu live). Below that the vendor's
		 * page allocator works from the bottom up, so a dump taken seconds after boot
		 * still has the high end intact - which is the whole race, and why the read has
		 * to happen the moment the flashed system answers.
		 *
		 * 0x9c000000 rather than 0x9d000000 because the first round caught the loader:
		 * kexec's arm64 placement put the trial kernel's own *text* at 0x9d000000 (the
		 * bytes read back there are a literal substring of the Image), and no-map binds
		 * the new kernel, not the loader. trial-kexec.sh now caps the placement below
		 * this region with --mem-max.
		 */
		ramoops: buffer@9c000000 {
			compatible = "ramoops";
			no-map;
			reg = <0x0 0x9c000000 0x0 0x00200000>;
			console-size = <0x100000>;
			record-size = <0x4000>;
			pmsg-size = <0x40000>;
		};
	};

	/* Not copied from SR1010 and not read off the stock DTB's *node names* either -
	 * the running vendor kernel publishes the claim list directly, and it is the
	 * authority: /sys/kernel/debug/gpio names the GPIO each LED holds.
	 *
	 *   10d10000 = &gpio0:  9 led_los, 10 led_power, 13 led_wps
	 *   10d10040 = &gpio1:  5 led_usb1, 8 led_wan
	 *   10d10080 = &gpio2:  3 led_phone1
	 *   10d100c0 = &gpio3: 15 led_pon
	 *   10d10100 = &gpio4:  1 led_wlan
	 *
	 * Active-low, measured rather than inherited: driving the vendor's own LED class
	 * (echo 255 > /sys/class/leds/led_power/brightness) pulls that pin to "out lo" and
	 * the lamp lights, and all eight GPIO LEDs did exactly that. The front row then
	 * names itself, left to right:
	 *   电源=led_power=gpio-10   注册=led_pon=gpio-63   光信号(red)=led_los=gpio-9
	 *   上网=led_wan=gpio-24      lan1..lan4=led_lan0..3  usb1=led_usb1=gpio-21
	 * led_wps and led_phone1 are GPIO-backed in the vendor's list but were never
	 * identified on the case, and **led_wlan is not described at all: this board has no
	 * wireless and no WLAN lamp** (owner, 2026-10-12) - the vendor reserves gpio-65 under
	 * that name the way it reserves led_usb2 (led-id 0x35), which also has no lamp here.
	 *
	 * What is deliberately absent: led_lan0..lan3 appear in the vendor's
	 * /sys/class/leds and do light up when written, but they claim **no GPIO** in that
	 * list - the vendor reaches them through the SoC's LED engine instead, addressed by
	 * the stock DTB's `led-id` cell (led_power = 0x33, led_usb1 = 0x34, led_los = 0x08,
	 * ...), and on this panel those four are its only users. Mainline has no driver for
	 * that engine (see the OPEN ITEMS above), so the four LAN LEDs cannot be described
	 * here at all - they will stay dark under mainline even when a port links, and that
	 * is a missing feature of this SoC's mainline support, not a boot failure.
	 */
	leds {
		compatible = "gpio-leds";

		led-power {
			color = <LED_COLOR_ID_GREEN>;
			/* "on" rather than "keep" is the point, not a style choice: with no
			 * serial port the panel is the only witness that exists before
			 * userspace, and the vendor leaves every lamp dark, so a kernel that
			 * reaches gpio-leds probe lights it by itself. That gives three states
			 * to read off the case - dark = never got here, solid = probe done but
			 * /init never ran, blinking = userspace alive.
			 */
			default-state = "on";
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
			label = "skyworth:green:power";
		};

		led-pon {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "keep";
			function = LED_FUNCTION_WAN;
			gpios = <&gpio3 15 GPIO_ACTIVE_LOW>;
			label = "skyworth:green:pon";
		};

		led-los {
			color = <LED_COLOR_ID_RED>;
			default-state = "keep";
			function = LED_FUNCTION_WAN;
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
			label = "skyworth:red:los";
		};

		led-wan {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "keep";
			function = LED_FUNCTION_LAN;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			label = "skyworth:green:wan";
		};

		led-usb1 {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "keep";
			function = LED_FUNCTION_USB;
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
			label = "skyworth:green:usb1";
		};

		led-phone1 {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "keep";
			gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;
			label = "skyworth:green:phone1";
		};

		led-wps {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "keep";
			function = LED_FUNCTION_WPS;
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			label = "skyworth:green:wps";
		};
	};

	thermal-zones {
		soc-thermal {
			thermal-sensors = <&pvt>;
		};
	};
};

&uart0 {
	status = "okay";
};

&pvt {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&pon_serdes {
	status = "okay";
};

&uni_serdes {
	status = "okay";
};

&nppt {
	/* zx279133.dtsi says 2500base-x, and that is a lie for this port as we
	 * have to use it: it makes 2500baseT the only legal mode in phylink's
	 * supported mask, so `ethtool -s eth0 speed 1000` moves only the PHY's
	 * copper side while the lane keeps running 2.5G, and the RTL8221B does
	 * not rate-adapt there. Measured on 2026-10-16 in exactly that state:
	 * `Link is Up - 1Gbps/Full` and carrier=1 at both ends, but board
	 * rx_packets stayed 0 and a 20-packet burst changed not one byte of the
	 * peer's received counters - a link that carries nothing.
	 *
	 * 1000BASE-X/SGMII is what this cable actually runs, measured from the
	 * vendor bootloader on the same jack: its net init prints
	 * `phy_id:0x5 port:0x4`, `mode_eth_1gbase_x_cfg`,
	 * `xmac 0 speed set 2 in sgmii(xmac speed 3)`,
	 * `mac 4 phy status changed: 1000M full-duplex`, then moved 12013 bytes
	 * by tftp at 1.9 MiB/s. zx279133-mac.c accepts exactly 2500BASEX and
	 * SGMII and carries the vendor's recovered 1G XPCS bring-up.
	 *
	 * It was NOT the whole fix, and that is measured too (2026-10-17): with
	 * phy-mode="sgmii" the mask is right at last (`Supported link modes:
	 * 10/100/1000baseT`, `Link partner advertised ... 1000baseT/Full`) and the
	 * port still moves nothing - rx_packets 0, no RX counter in ethtool -S at
	 * all while xmac_tx_good_frames counts 12 frames into the lane, IRQ
	 * `22: 0 0 GICv3 33 Level 19000000.ethernet`, and the peer's ReceivedBytes
	 * unmoved across six pings whose ARP stayed Incomplete. The same power
	 * cycle had U-Boot print `uni serdes init succeed` and pull 11,440,284
	 * bytes before bootm, so the leftovers are not what was missing either:
	 * mainline's own bring-up configures the other pair.
	 */
	phy-mode = "sgmii";
	/* Which of nppt's two MAC windows carries this port. The vendor bootloader says
	 * `xmac0 is used` on this jack, and np_133.ko addresses the windows as
	 * 0x140000 + id * 0x40000 (id=1 is the base every constant in zx279133-mac.c was
	 * written against), so this port is id 0. See docs 补五十四.
	 */
	zte,xmac-id = <0>;

	/* This is the second half, and it is a claim about a binding, not a
	 * profile. zx279133-main.c takes exactly one PHY (`devm_phy_get(dev,
	 * "serdes")`, :429) and exactly one PCS (`of_parse_phandle(..., "pcs-handle", 0)`,
	 * :434), while zx279133.dtsi spells "serdes" as <&pon_serdes>, "lan-serdes"
	 * as <&uni_serdes>, pcs-handle as <&xpcs1> and the LAN-side PCS as
	 * zte,lan-pcs-handle = <&xpcs0>. Repo-wide the only consumer of
	 * "lan-serdes" and zte,lan-pcs-handle is drivers/net/dsa/zx279133-rtl8372n.c
	 * (:7756, :7785) - the external switch this board does not have. So on this
	 * board the two properties the LAN driver reads name the PON pair, and
	 * nothing ever calls the UNI serdes: U-Boot's bring-up for this jack is
	 * `mode_eth_1gbase_x_cfg` + `uni serdes init succeed` + `xmac 0 speed set 2
	 * in sgmii`, i.e. xpcs0 + uni_serdes, and `/proc/pon/outer_phy` on the stock
	 * system says `xmac0: phy_RTL8226`.
	 *
	 * Re-aim the slots the driver actually reads. Expected and still informative
	 * either way: phy-zx279133-uni-serdes.c's set_mode() only accepts
	 * USXGMII/10GBASE-R, so it will answer -EOPNOTSUPP for sgmii and
	 * power_on() (its 10G profile) will not run. That makes the UNI lane stay
	 * exactly as U-Boot left it and, critically, stops mainline reprogramming
	 * pon_serdes/xpcs1 underneath it. Frames appearing = mainline's PON-side
	 * programming was the thing breaking the lane, and the remaining work is a
	 * measured 1000BASE-X profile for uni_serdes (from the captured
	 * 0x16100000 block, not from the 10G array). Frames still absent = the lane
	 * needs more than leaving it alone, and with CONFIG_DEVMEM now pinned the
	 * same absolute addresses read under mainline (`md`-for-`dd`) say which bits
	 * differ from the traffic-proven values, instead of another guess.
	 */
	phys = <&uni_serdes>;
	phy-names = "serdes";
	pcs-handle = <&xpcs0>;
	memory-region = <&bmu_reserved>, <&se_hash_reserved>, <&idm_reserved>;
	memory-region-names = "bmu", "se-hash", "idm";
	/* No /delete-property/ phy-handle here, and that is a measured choice, not an oversight:
	 * the base node has no such property to delete. Read from upstream-read/zx279133.dtsi:462
	 * (nppt: ethernet@19000000) on 2026-10-19, the SoC include gives this node
	 * `compatible`, `reg`, `reg-names = "nppt", "pps"`, `interrupts`/`interrupt-names`,
	 * `pcs-handle = <&xpcs1>`, `zte,lan-pcs-handle = <&xpcs0>`,
	 * `phy-names = "serdes", "lan-serdes"` and `status = "disabled"` - and no `phy-handle`.
	 * The only `phy-handle` this port ever had was the one this file itself wrote, and that
	 * line is gone. Deleting a property that does not exist is also what run 56 died on
	 * (4m 29s into the DTS gate, "does not compile while sr1010.dts does"), so the guard lives
	 * where it can be checked instead: the CI content gate asserts against the compiled blob
	 * that this node has `fixed-link` and has no `phy-handle`, which fails loudly if a future
	 * SoC include ever starts handing this port a PHY.
	 */
	/* fixed-link, and it is the PHY half of the inherit decision the uni_serdes
	 * driver made in run 52. Measured 2026-10-18 22:20 (run 53, the round after
	 * the lane was finally left alone):
	 *   [    4.230596] ... Uni SerDes 1G inherited: mode 0x1 already, image differs in 0/49 word(s)
	 *   [    4.258513] ... eth0: PHY [14f02000.mdio:05] driver [RTL8221B-VB-CG 2.5Gbps PHY (C22)] (irq=POLL)
	 *   [    4.259470] ... eth0: configuring for phy/sgmii link mode
	 *   ethtool: Supported link modes: 10baseT/Half 10baseT/Full | Link detected: no
	 *   rx_packets 0 in all four readings, and tx_packets 0 as well.
	 * So the SoC half of the lane is now provably byte-identical to the state that
	 * moved 11 MB through this jack in U-Boot, and the port is still silent. What
	 * is *not* inherited is the other end of the SerDes: attaching the PHY runs
	 * phy_attach_direct() -> phy_init_hw(), which soft-resets the RTL8226B and
	 * replays realtek's config_init over C22 extended registers, and the mask that
	 * came back is the tell - a PHY U-Boot had running at 1000M/full on this very
	 * jack reports 10baseT only, i.e. it was left in a mode none of the recovered
	 * tables describe. Link down also means phylink never reaches mac_link_up(),
	 * which is why tx fell to 0 where run 50 counted xmac_tx_good_frames 12.
	 *
	 * A fixed link removes the whole PHY state machine: phylink_parse_mode() sees
	 * this child node and sets MLO_AN_FIXED, phylink_expects_phy() then answers
	 * false, phylink_fwnode_phy_connect() returns before phy_attach_direct(), and
	 * phy_init_hw() has no other caller on a boot that never suspends. So no
	 * *write* reaches the chip - no soft reset, no config_init replay - and it keeps
	 * exactly what U-Boot left, including the copper-side auto-negotiation with the
	 * peer, which is what the 11 MB download already proved works. Reads are a
	 * different matter and this sentence used to deny them: of_mdiobus still
	 * instantiates 14f02000.mdio:05, binds RTL8221B-VB-CG, and phy_probe() calls
	 * .probe and .get_features on that bus, which is how the line above at
	 * 4.258513s could name the driver at all. phy-handle must NOT come back beside
	 * this node: the rtl8226b node stays in &mdio1 as the record of what is at
	 * address 5, and of_mdiobus still reads its ID, but nothing may attach it.
	 *
	 * What still runs is mainline's own zx279133_xmac_sgmii_init() and
	 * zx279133_wan_port_bringup() from mac_link_up(), so this round separates the
	 * last two causes: frames both ways = the PHY re-init was what killed the
	 * lane; TX-only again = the MAC bring-up is the second thing that has to
	 * inherit.
	 */
	/* No MAC source yet: SR1010 reads it from an nvmem-layout over its own
	 * "tags" partition, whose zte,sr1010-tags parser does not describe this
	 * unit's "parameter tags" layout. With neither nvmem-cells nor a literal
	 * local-mac-address the driver falls back to a generated random MAC, which
	 * is usable for the trial - hardcoding D0:45:8D:84:08:FC would only be
	 * right for this one board.
	 */
	status = "okay";

	/* LAST in this node, and it has to be: dtc orders a node as properties-then-subnodes
	 * ("Properties must precede subnodes", run 60 at 393.2-18), so a `fixed-link {}` written
	 * among the properties kills the build - and runs 56-59 died on exactly that before the
	 * DEVMEM change ever got measured. devtools/dtslint.py now checks this rule locally.
	 */
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	/* The one external PHY on this board. Evidence from the running unit:
	 *  - /lib/modules/4.19.136+/rlt8226b.ko + /sys/module/rlt8226b, dmesg
	 *    "Start insmod R8226b_init!" / "r8226b_phy_probe: 576: rtl8226b Phy
	 *    Driver Probe Done", and its outerphy table names index 5 phy_RTL8226.
	 *  - /sys/firmware/devicetree/base/soc/pon_plat/mdio_8226_id = <1>, and
	 *    dmesg labels 14f02000.mdio "MDIO id = 1" -> this bus, address 5
	 *    (SR1010 has its PHY at address 1 on the same bus).
	 *
	 * Deliberately **no compatible**: SR1010's node says
	 * "ethernet-phy-id0000.84b9", which is the ZX279051's ID, and a compatible
	 * on a PHY node overrides ID matching - the first mainline trial therefore
	 * bound the ZX279051 driver to a Realtek chip and wrote ZX279051 registers
	 * into it, which is the plainest explanation for a board that otherwise
	 * clearly ran (its 9132 ports went down, so mainline had re-initialised the
	 * SoC) while the one cable that matters stayed dead. Without a compatible,
	 * phylib matches the ID the chip actually reports against CONFIG_REALTEK_PHY
	 * ("Currently supports RTL821x/RTL822x"), which is enabled for that reason
	 * in scripts/configure-sk-d840n.sh, and genphy remains the fallback.
	 *
	 * Also deliberately **no reset-gpios**: derived from the stock bdinfo
	 * "phy-reset = <0x28>" (global GPIO 40 = &gpio2 8) it is the one number here
	 * that was never confirmed, and phylib *asserts* a reset GPIO it is told
	 * about - wrong pin, and the PHY is held in the wrong state instead of
	 * simply being configured. The PHY is already out of reset when the kernel
	 * starts on this unit, because the vendor bootloader configured it.
	 */
	rtl8226b: ethernet-phy@5 {
		reg = <5>;
		max-speed = <2500>;
	};
};

&xpcs0 {
	status = "okay";
};

&xpcs1 {
	status = "okay";
};

/* Both watchdogs are switched off for the trials, and the reason is the window
 * they would cut, not a belief that nothing feeds them: zx279133.dtsi already
 * ships watchdog0 (14f09000) as "okay" with timeout-sec = <10> and
 * zte,restart-watchdog, and procd's watchdog_init() opens /dev/watchdog whenever
 * the node exists (it is not gated on system.@system[0].watchdog_timeout), so an
 * image that reaches procd does feed it. What has no feeder is everything before
 * procd - driver probe, first-boot board detection - and a 10 s timeout armed the
 * moment procd starts is what then bites, with no console to see it from.
 *
 * The ~43 s reset measured after kexec-ing this board's Image was *not* this
 * watchdog: the 4.19 vendor kernel arms three zx_wdt instances at 8 s and feeds
 * them in-kernel, that feeding stops when the old kernel dies, and the reset
 * routing is the volatile CRM register 0x10e10208 (writing it to 0x0 keeps the
 * board up; 0x101 only delays the bite).
 *
 * To be settled from a shell on mainline, then re-enabled for the flashed image:
 * with watchdog0 "okay", a flashed mainline that hangs early at least resets
 * instead of wedging - which is not recovery (there is no A/B and no serial), but
 * it is better than a board that has to be power-cycled to notice anything.
 */
&watchdog0 {
	status = "disabled";
};

&watchdog1 {
	status = "disabled";
};

/* Two constraints, and they only fit together one way.
 *
 * 1. No env edit is needed to boot this image: U-Boot's bootargs say
 *    `root=/dev/mtdblock5`, so `root` has to end up as /dev/mtdblock5. That is now
 *    *pinned* rather than counted - see the mtd1..mtd6 aliases above. Counting nodes
 *    was the old approach and it was not safe: whether the SPI-NAND master itself takes
 *    mtd0 depends on CONFIG_MTD_PARTITIONED_MASTER (mtdcore.c: `if
 *    IS_ENABLED(CONFIG_MTD_PARTITIONED_MASTER) add_mtd_device(mtd)` runs before the
 *    partitions are registered), so the same blob is mtd4 or mtd5 depending on a kernel
 *    config nobody is looking at. A pin cannot drift.
 * 2. The image has to be programmable from the system that is installed now.
 *    That flasher runs on the vendor 4.19 and writes by partition LABEL,
 *    because `/sbin/mtd` can only erase/write a whole partition - there is no
 *    tool on this image that erases a sub-range. The 4.19's own mtd table puts
 *    `root` at 0xf00000, so `root` here must start at 0xf00000 too: an offset
 *    of 0x1000000 would have the flasher write the jffs2 one erase block
 *    *below* where the new kernel looks for it, which boots as a panic on an
 *    empty root and leaves no way back without a serial cable.
 *
 * The pin also frees the table from the hack that used to satisfy (1): U-Boot's single
 * 4096k `parameter tags` region is no longer split in two to fill a slot, so it is one
 * read-only node again and still covers the bytes U-Boot keeps its MAC/calibration in.
 * `scratch` (1 MiB at 0xff00000) is not a usable log area either - erasing a sub-range
 * needs the MEMERASE ioctl, which no tool on this image provides - its only job is to
 * keep the chip fully described.
 *
 * Offsets/labels otherwise mirror the community U-Boot env
 * (boot 2048k@0x0, kernel 8192k@0x200000, dtb 1024k@0xa00000,
 *  "parameter tags" 4096k@0xb00000, root 246784k@0xf00000).
 */
&spifc {
	spi-max-frequency = <25000000>;
	status = "okay";

	flash@0 {
		partitions-only;
		spi-max-frequency = <25000000>;

		/delete-node/ partitions;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			bootpart: partition@0 {
				label = "boot";
				reg = <0x000000 0x200000>;
				read-only;
			};

			kernelpart: partition@200000 {
				label = "kernel";
				reg = <0x200000 0x800000>;
			};

			dtbpart: partition@a00000 {
				label = "dtb";
				reg = <0xa00000 0x100000>;
			};

			tagspart: partition@b00000 {
				label = "parameter tags";
				reg = <0xb00000 0x400000>;
				read-only;
			};

			rootpart: partition@f00000 {
				label = "root";
				reg = <0xf00000 0xf000000>;
			};

			scratchpart: partition@ff00000 {
				label = "scratch";
				reg = <0xff00000 0x100000>;
			};
		};
	};
};

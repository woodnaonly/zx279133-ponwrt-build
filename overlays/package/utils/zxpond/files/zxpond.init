#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

start_service() {
	/usr/sbin/zxpond --migrate || return 1
	chmod 600 /etc/config/pon
	[ ! -L /etc/pon/identity ] && [ -f /etc/pon/identity ] && chmod 600 /etc/pon/identity
	procd_open_instance
	procd_set_param command /usr/sbin/zxpond
	procd_set_param respawn 3600 5 0
	procd_set_param file /etc/config/pon
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger pon
}

reload_service() {
	restart
}

[ -n "${IPKG_INSTROOT:-}${PKG_ROOT:-}" ] && exit 1
[ "$(uci -q get luci.main.skd840n_argon_migrated)" = 1 ] && exit 0
[ -f /www/luci-static/argon/css/cascade.css ] || exit 1
uci batch <<'EOF'
set luci.themes.Argon='/luci-static/argon'
set luci.main.mediaurlbase='/luci-static/argon'
set luci.main.skd840n_argon_migrated='1'
commit luci
EOF

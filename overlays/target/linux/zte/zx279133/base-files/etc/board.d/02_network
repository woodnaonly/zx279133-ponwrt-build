#!/bin/sh
# Overlaid on cnjn's file, so the sr1010 case is kept exactly as upstream has it.
#
# SK-D840N: the interface names here decide the address the board answers on, so
# they decide whether anyone holding a cable can see the board at all.
#
# What this header used to claim - that the only netdev mainline could drive was
# the NPPT's eth0, because the SoC-internal 9132 UNI switch had no mainline
# driver and the vendor drove it through /dev/ethdriver without phylib or DSA -
# is out of date.  The 9132 has been a registered DSA switch since run 100, and
# on the flashed system lan1..lan4 and the lan-cpu0 conduit all exist and carry
# traffic (docs/24 for the bring-up, docs/90 for the per-jack egress fix).
# 99-default_network still cannot fill any of it in: it exits as soon as
# /etc/config/network already has a network object, so this file is the one place
# the default is decided.
#
# The vendor's own naming is the reason for the care below.  Its
# /etc/config/network says "lan bridge = eth1 eth2 eth3, wan.device = eth0", but
# those ethN are vendor switch ports rather than Linux netdevs, and taking them
# for netdevs is how this board's panel map got wrong - the panel's 2.5G jack is
# not eth0 at all: it is the 9132's fifth user port, lan5 (docs/90 §6, revised
# by docs/92 §90).

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

case "$(board_name)" in
zte,zx279133-sr1010)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "eth0"
	;;
skyworth,sk-d840n)
	# The address is spelled out here rather than left to config_generate's default, and it
	# has to be 192.168.9.1. Confirmed by extracting the image that is actually built
	# (staging/trial/flash-rootfs.jffs2, read with jefferson):
	#   /etc/config/dropbear   -> ships "option Interface 'lan'" (the OpenWrt package default;
	#                              nothing in this overlay or in target/linux/zte overrides it)
	#   /etc/init.d/dropbear   -> present, so the daemon really starts
	#   /etc/config/network    -> ABSENT, i.e. generated on first boot by config_generate
	# and dropbear.init binds an Interface to the *IP addresses on* it (network_get_ipaddrs_all),
	# not to a netdev. So the address below decides the only address ssh will answer on.
	#
	# config_generate would supply 192.168.1.1 for lan
	# (base-files/files/bin/config_generate: lan) ipad=${ipaddr:-"192.168.1.1"}).
	# That is wrong twice over here:
	#   - every tool in this project waits on 192.168.9.x, so the board would be reported dead
	#     while it is up and serving ssh
	#   - the owner's own router answers 192.168.1.1 on the 192.168.1.0/24 this PC is also on,
	#     so that address cannot be told apart from the LAN's gateway by anything that pings it
	# 192.168.9.1 is the address the installed vendor image already uses for its lan bridge, so
	# this also keeps the rollback target and the flashed system on one address.
	#
	# Which netdev carries the LAN depends on what the 9132's driver managed to bring up,
	# and every case here is real:
	#
	#   lan1 lan2 lan3 lan4  the 9132's UNI jacks as separate DSA ports, one netdev
	#                        per jack.  All of them are LAN - see the note under
	#                        the loop.
	#   lan5                the panel's 2.5G jack: the 9132's fifth user port, the one
	#                        the vendor calls the outerphy, with the external RTL8226
	#                        on &mdio1 at address 5 (docs/92 §90).
	#   lan-cpu0             the conduit - the 9132's CPU port.  It is a member of the
	#                        LAN bridge, never the LAN's only member and never a WAN.
	#   eth0                 the NPPT's own netdev - the PON side.  Two jobs: it is
	#                        the `wan` slot, and it is the fallback LAN, so an image
	#                        whose lane never came up still has an address and still
	#                        answers instead of coming up with none.  It is NOT the
	#                        panel's 2.5G jack: an earlier version of this comment said
	#                        so, and it was wrong (docs/92 §90).
	#
	# `uni` is set by the loop rather than testing the finished string, because the old
	# predicate was a glob on the first name (`case "$lan_dev" in lan1*`) and a board that
	# registered lan3 but not lan1 fell through it - losing the CPU port from its bridge,
	# which is the one thing that makes every jack reachable from the router.
	lan_dev=""
	uni=""
	for d in lan1 lan2 lan3 lan4 lan5; do
		[ -e "/sys/class/net/$d" ] && { lan_dev="$lan_dev${lan_dev:+ }$d"; uni=1; }
	done
	[ -n "$lan_dev" ] || { [ -e /sys/class/net/lan-cpu0 ] && lan_dev="lan-cpu0"; }
	[ -n "$lan_dev" ] || lan_dev="eth0"
	#
	# By default every jack on the panel is a LAN jack and none of them is a
	# WAN.  That is the owner's rule, stated 2026-10-26: 「默认都是 lan 口
	# 需要 wan口的 用户自己去设置」.  Reserving a jack is not a neutral choice:
	# a port netifd has handed to the WAN stops answering on 192.168.9.1, so to
	# anyone holding a cable it is indistinguishable from a dead port - which is
	# how three of the four jacks were being reported while the egress defect of
	# docs/90 was still in the way.  The NAT round is the one caller that wants a
	# WAN; it makes one for itself and puts this default back afterwards
	# (tools/portmove.sh, tools/restore.sh).
	#
	# A `wan` section still exists, on `eth0`, rather than being deleted.  Three
	# reasons, each of them about what breaks without it:
	#
	#   * `uci set network.wan.device=lanX` - which is what a user does and what
	#     every bench script does - writes into a section that has to exist.
	#     Without one they would have to `uci add` first, and a uci failure on a
	#     board nobody can look at reads as a dead port.
	#   * `wan6` is generated alongside `wan`, so keeping the section keeps the
	#     pair consistent - tools/portsall.sh sets both fields.
	#   * /etc/init.d/sk-nat re-reads network.wan.device every 15 s and puts the
	#     masquerade wherever it points.  On eth0 the rule sits on a link that
	#     carries nothing, which is the no-op wanted; on a real uplink it works
	#     with nothing else to change, so the NAT half of this board needs no
	#     rebuild when a user picks a WAN port.
	#
	# The panel, measured on run 185 and written up in docs/90 §6, and corrected by
	# docs/92 §90.  This replaces a table here that was inherited from jack walks
	# run on an image in which only eth0 could send, and it got eth0 wrong twice:
	# eth0 is the NPPT's own netdev - the PON side - and neither "jack 4" nor the
	# panel's 2.5G jack.  The netdev stays lan5. Its published rate is the
	# RTL8226 copper status (1f.0xa434), written over the DTS fixed-link
	# ceiling by phylink_fixed_state(). On this 6.18 tree that callback is
	# installed for the user port in dsa_user_phy_setup(), so a 1G peer is
	# reported as 1000 and not as the DTS ceiling of 2500.
	#
	#   DSA port 4 = PPU 1 = PHY 0x0a = lan1   no jack on this SKU
	#   DSA port 5 = PPU 2 = PHY 0x0b = lan2   panel LAN2
	#   DSA port 6 = PPU 3 = PHY 0x0c = lan3   panel LAN3
	#   DSA port 7 = PPU 4 = PHY 0x0d = lan4   panel LAN4
	#   DSA port 8 = PPU 5 = RTL8226 = lan5    panel LAN1, the 2.5G jack
	#   (not DSA)    NPPT   = the PON side = eth0
	#
	# The 2.5G jack is the 9132's fifth user port, the one the vendor
	# calls the outerphy, and its PHY is the external RTL8226 on &mdio1
	# at address 5 - not the SoC's own MAC.  An earlier version of this
	# comment claimed the opposite ("eth0 is the panel's LAN1 2.5G jack")
	# and it was wrong: the loader's own log says the RTL8226 comes up on
	# the 9132's port 4 (the outerphy) and that the SoC reaches it over
	# the 9132's CPU port, the same way it reaches the other three jacks
	# (docs/92 §90).  eth0 is the NPPT's own netdev - the PON side - and
	# is the `wan` slot.
	#
	# lan1 being a netdev with no jack behind it is why leaving it in the bridge
	# costs nothing and why it must not be "tidied" out of one.
	#
	# The other cases keep the single-interface behaviour above: one address on
	# the one netdev that exists, so the board is still reachable on the bench.
	#
	if [ -n "$uni" ]; then
		lan_ports="$lan_dev"
		#
		# The DSA CPU port has to be in the bridge as well.
		#
		# Every frame that comes in on a jack and is meant for the router
		# itself is delivered to the switch's CPU port, and every frame the
		# router sends towards a jack leaves through it.  It is a netdev of
		# its own (lan-cpu0) and the bridge is what the host side of the
		# switch is attached to - the user ports are bridges of their own and
		# the CPU port is not one of them.  A bridge without the CPU port
		# forwards between the jacks and never reaches the host: the router's
		# own address is on the bridge, the frames arrive on the CPU port, and
		# nothing on the CPU port belongs to the bridge, so they are dropped
		# there and no netdev ever counts a byte.
		#
		# Measured on the trial image on 2026-10-23: br-lan carried lan1, lan2
		# and lan4, and lan-cpu0 was in no bridge at all.
		[ -e /sys/class/net/lan-cpu0 ] && \
			lan_ports="$lan_ports${lan_ports:+ }lan-cpu0"
		#
		# The address is set with ucidef_set_interface, not with "uci set":
		# this image's /lib/functions/uci-defaults.sh is built on
		# json_select_object and writes /etc/config/network as a JSON
		# object, so a "uci set" against it is not guaranteed to be
		# accepted - and the symptom of it not being accepted is exactly
		# what this file exists to prevent: the network service puts the
		# default 192.168.1.1 on the bridge, the bench PC waits on
		# 192.168.9.1, and the board looks dead while it is up.
		ucidef_set_interface "lan" device "$lan_ports" protocol "static" \
			ipaddr "192.168.9.1" netmask "255.255.255.0"
		# The slot only exists if the port it names does; tests/test_network_binding.sh
		# is what proves eth0 is there, and if it ever is not, a WAN pointing at
		# nothing would be netifd chasing a netdev that was never registered.
		[ -e /sys/class/net/eth0 ] && \
			ucidef_set_interface "wan" device "eth0" protocol "dhcp"
	else
		ucidef_set_interface "lan" device "$lan_dev" protocol "static" \
			ipaddr "192.168.9.1" netmask "255.255.255.0"
	fi
	;;
*)
	echo "Unsupported hardware. Network interfaces not initialized"
	;;
esac

board_config_flush

exit 0

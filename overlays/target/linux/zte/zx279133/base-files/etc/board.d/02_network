#!/bin/sh
# Overlaid on cnjn's file, so the sr1010 case is kept exactly as upstream has it.
#
# SK-D840N: the only netdev mainline can drive is the NPPT port whose PHY is the
# external RTL8226, which the vendor image calls `wan`/eth0 (uci show network here:
# lan bridge = eth1 eth2 eth3, wan.device = eth0). eth1..eth3 come out of the
# SoC-internal "9132" UNI switch, which has no mainline driver - the vendor drives
# it through /dev/ethdriver without phylib or DSA - so there is nothing to name
# lan1..lanN here, and 99-default_network cannot fill the gap either: it exits as
# soon as /etc/config/network already has a network object. Left unhandled the
# image would boot with an address on a port that does not exist.

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

case "$(board_name)" in
zte,zx279133-sr1010)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "eth0"
	;;
skyworth,sk-d840n)
	# The address is spelled out here rather than left to config_generate's default, and it
	# has to be 192.168.9.1. Confirmed by extracting the image that is actually built
	# (staging/trial/flash-rootfs.jffs2, read with jefferson):
	#   /etc/config/dropbear   -> ships "option Interface 'lan'" (the OpenWrt package default;
	#                              nothing in this overlay or in target/linux/zte overrides it)
	#   /etc/init.d/dropbear   -> present, so the daemon really starts
	#   /etc/config/network    -> ABSENT, i.e. generated on first boot by config_generate
	# and dropbear.init binds an Interface to the *IP addresses on* it (network_get_ipaddrs_all),
	# not to a netdev. So the address below decides the only address ssh will answer on.
	#
	# config_generate would supply 192.168.1.1 for lan
	# (base-files/files/bin/config_generate: lan) ipad=${ipaddr:-"192.168.1.1"}).
	# That is wrong twice over here:
	#   - every tool in this project waits on 192.168.9.x, so the board would be reported dead
	#     while it is up and serving ssh
	#   - the owner's own router answers 192.168.1.1 on the 192.168.1.0/24 this PC is also on,
	#     so that address cannot be told apart from the LAN's gateway by anything that pings it
	# 192.168.9.1 is the address the installed vendor image already uses for its lan bridge, so
	# this also keeps the rollback target and the flashed system on one address.
	#
	# Which netdev carries the LAN depends on what the 9132's driver managed to bring up,
	# and all three cases are real:
	#
	#   lan1 lan2 lan3 lan4  the 9132's four UNI jacks as separate DSA ports.  This is the
	#                        one that gives a port per jack, and the one a lab router
	#                        needs: one jack as the WAN uplink, the rest as the LAN.
	#   lan-cpu0             the conduit - the 9132's CPU port, which reaches all four
	#                        jacks as one flat network.
	#   eth0                 the NPPT's own port, jack 4 (the external RTL8226).  The
	#                        fallback: an image whose lane did not come up still has an
	#                        address and still answers, instead of coming up with none.
	lan_dev=""
	for d in lan1 lan2 lan3 lan4; do
		[ -e "/sys/class/net/$d" ] && lan_dev="$lan_dev${lan_dev:+ }$d"
	done
	[ -n "$lan_dev" ] || { [ -e /sys/class/net/lan-cpu0 ] && lan_dev="lan-cpu0"; }
	[ -n "$lan_dev" ] || lan_dev="eth0"
	#
	# The lab router needs one jack as the WAN and another as the LAN, and
	# the two must be separate segments - that is the whole point of the
	# NAT test.  So when the per-port netdevs are there, the jack the test
	# PC is plugged into becomes the LAN bridge and the jack that already
	# carries the uplink cable becomes the WAN, and the WAN takes a DHCP
	# lease from whatever is upstream instead of carrying the bench's
	# static address.
	#
	# Which DSA port is which physical jack is measured, not guessed:
	#
	#   DSA port 4 = PPU 1 = PHY 0x0a = the 9132's UNI1
	#   DSA port 5 = PPU 2 = PHY 0x0b = the 9132's UNI2  <- the test PC
	#   DSA port 6 = PPU 3 = PHY 0x0c = the 9132's UNI3  <- the uplink
	#   DSA port 7 = PPU 4 = PHY 0x0d = the 9132's UNI4
	#
	# The vendor's own naming confirms the last two: the vendor prints
	# "[eth1] port 1 link up:1000M" for the jack the PC is in and calls
	# that switch port 1, and its sw_port table says switch port 1 is
	# smac_1, which is PPU 2.  The vendor's eth2 is switch port 2 = smac_2
	# = PPU 3, and it is the port that has a cable in it on this bench.
	#
	# The labels in the device tree follow the DSA port number (lan1 is
	# DSA port 4), so the PC's jack is lan2 and the uplink's is lan3.
	#
	# The rest of the cases keep the single-interface behaviour above:
	# one address on the one netdev that exists, so the board is still
	# reachable on the bench.
	#
	case "$lan_dev" in
	lan1*)
		lan_ports=""
		wan_port=""
		for d in $lan_dev; do
			[ "$d" = lan3 ] && { wan_port="lan3"; continue; }
			lan_ports="$lan_ports${lan_ports:+ }$d"
		done
		if [ -n "$wan_port" ] && [ -n "$lan_ports" ]; then
			ucidef_set_interfaces_lan_wan "$lan_ports" "$wan_port"
			uci set network.lan.ipaddr='192.168.9.1'
			uci set network.lan.netmask='255.255.255.0'
		elif [ -n "$lan_ports" ]; then
			ucidef_set_interface "lan" device "$lan_ports" protocol "static" \
				ipaddr "192.168.9.1" netmask "255.255.255.0"
		else
			ucidef_set_interface "lan" device "$lan_dev" protocol "static" \
				ipaddr "192.168.9.1" netmask "255.255.255.0"
		fi
		;;
	*)
		ucidef_set_interface "lan" device "$lan_dev" protocol "static" \
			ipaddr "192.168.9.1" netmask "255.255.255.0"
		;;
	esac
	;;
*)
	echo "Unsupported hardware. Network interfaces not initialized"
	;;
esac

board_config_flush

exit 0

#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# config_generate skips LED defaults when an upgrade retains /etc/config/system.
[ -n "${IPKG_INSTROOT:-}${PKG_ROOT:-}" ] && exit 1

. /lib/functions.sh
[ "$(board_name)" = "skyworth,sk-d840n" ] || exit 0
. /lib/functions/sk-d840n-leds.sh

configured=' '
commands=''
check_panel_led() {
	local sysfs
	config_get sysfs "$1" sysfs
	case "$sysfs" in
	skyworth:green:wps)
		# This SKU has no WPS lamp. Only remove sections for that exact LED.
		commands="$commands
delete system.$1"
		;;
	*) configured="$configured$sysfs " ;;
	esac
}
config_load system || exit 1
config_foreach check_panel_led led

# Keep the filename so upgrades of the original LAN1-only image run this too.
skd840n_led() {
	local port
	# Any existing owner wins, even a disabled LED or a custom trigger/device.
	case "$configured" in *" $3 "*) return 0 ;; esac
	# Anonymous sections cannot overwrite a user section with the same name.
	commands="$commands
add system led
set system.@led[-1].name='$2'
set system.@led[-1].sysfs='$3'
set system.@led[-1].trigger='$4'
set system.@led[-1].default='$5'"
	case "$4" in
	netdev)
		commands="$commands
set system.@led[-1].dev='$6'
set system.@led[-1].mode='$7'"
		;;
	usbport)
		for port in $8; do
			commands="$commands
add_list system.@led[-1].port='$port'"
		done
		;;
	esac
}
skd840n_led_defaults || exit 1
[ -n "$commands" ] || exit 0
uci batch <<EOF
$commands
commit system
EOF

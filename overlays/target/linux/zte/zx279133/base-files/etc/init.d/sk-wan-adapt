#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# The adaptive second WAN: it finds an uplink among the panel jacks, keeps
# the port that is the second WAN out of the bridge, and moves the traffic
# to the other WAN when the primary one stops working.
START=90
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/sk-wan-adapt
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sk_wan
}

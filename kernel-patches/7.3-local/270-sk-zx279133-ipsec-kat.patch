Subject: crypto: add an opt-in ZX279133 IPsec cold-boot diagnostic

Wire the SK-D840N board layer's single-block hardware test. Leave the
option off by default and make it built-in only: in-flight DMA cannot
yet be quiesced reliably.

--- a/drivers/crypto/Kconfig
+++ b/drivers/crypto/Kconfig
@@ -831,4 +831,16 @@
 source "drivers/crypto/inside-secure/eip93/Kconfig"
 source "drivers/crypto/ti/Kconfig"
 
+config CRYPTO_DEV_ZX279133_IPSEC_KAT
+	bool "ZX279133 IPsec cold-boot diagnostic"
+	depends on ARM64 && OF_RESERVED_MEM
+	depends on !KEXEC_CORE && !SUSPEND && !HIBERNATION
+	select CRYPTO_LIB_AES
+	select CRYPTO_SKCIPHER
+	help
+	  Run a one-shot hardware AES test on SK-D840N. Also requires an
+	  enabled device and its no-map reservation in the boot DT and
+	  zx279133_ipsec_kat.enable=1 on the kernel command line. This does
+	  not register algorithms unless zx279133_ipsec_kat.provider=1 is set.
+
 endif # CRYPTO_HW
--- a/drivers/crypto/Makefile
+++ b/drivers/crypto/Makefile
@@ -52,3 +52,4 @@
 obj-y += starfive/
 obj-y += cavium/
 obj-y += ti/
+obj-$(CONFIG_CRYPTO_DEV_ZX279133_IPSEC_KAT) += zx279133-ipsec-kat.o

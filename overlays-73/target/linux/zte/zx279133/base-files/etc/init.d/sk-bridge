#!/bin/sh /etc/rc.common
# Put the 9132's DSA user ports into the LAN bridge, and keep the conduit
# out of it.
#
# THE BRIDGE HAS TO HOLD THE USER PORTS, NOT THE CONDUIT
#
# The 7.3 generation of this board serves its LAN with a DSA switch: the
# conduit (lan-cpu0) is the CPU-facing netdev, and the jacks come up as DSA
# user ports (lan0..lan4) whose master is the conduit.  A DSA bridge may
# hold either the conduit or the user ports, never both, and the kernel
# says so.  Measured on the running 7.3.4 board on 2026-11-24, 17:45:
#
#	# an empty bridge takes a user port
#	ip link add br-t type bridge
#	ip link set dev lan0 master br-t          -> RC=0
#	# and then refuses the conduit
#	ip link set dev lan-cpu0 master br-t      -> RTNETLINK answers: Invalid argument
#
# and the other way round, on a bridge that already holds the conduit:
#
#	ip link set dev lan0 master br-lan        -> RTNETLINK answers: Invalid argument
#
# The rule is in the DSA core, net/dsa/user.c: a DSA conduit may only take
# a bridge as its upper (dsa_conduit_prechangeupper_sanity_check()), and a
# bridge that holds DSA user ports may not take a DSA conduit as a lower
# device (dsa_bridge_prechangelower_sanity_check()).  Both refusals come
# back as EINVAL, which is what "Invalid argument" is.
#
# So the LAN bridge of this board holds the five user ports and leaves the
# conduit outside it.  That is not a preference: the two lists cannot live
# in one bridge.
#
# WHAT WAS WRONG BEFORE
#
# The preinit-stage generation publishes the LAN as the conduit alone,
# because the 9132's DSA ports are registered about a second AFTER the
# config is generated: lib/preinit/82_config_generate runs board_detect
# and then config_generate right after the kernel has pivoted into the
# new rootfs (measured 2026-11-24 11:34, staging/ctl/serial.log:
#
#	[    1.705159] VFS: Pivoted into new rootfs
#	- generating board file -
#
# ) and the 9132's ports come up two seconds later:
#
#	[    2.653688] zx279133-switch: the 9132 is serving: the jacks are the
#	             9132's UNI ports 1..4 (DSA ports 4..7) ...
#
# The generation's loop over lan1..lan4 finds nothing, its fallback finds
# lan-cpu0, and the bridge comes out as:
#
#	config device
#		option name 'br-lan'
#		list ports 'lan-cpu0'
#
# The earlier 7.3 copy of this script repaired that by ADDING the jacks
# and the conduit to that list, which is the one list the kernel refuses:
# a bridge with lan-cpu0 in it takes no user port, and a bridge with a
# user port in it takes no conduit.  The result was a bridge that the
# kernel filled with neither.
#
# WHAT THIS COPY DOES
#
# It waits for the 9132's DSA ports to exist, makes the bridge hold all
# five of them, and takes the conduit out of it if the generation put it
# there.  It runs twice on the first boot: once from the uci-defaults
# script /etc/uci-defaults/99-sk-bridge (inside boot's uci_apply_defaults,
# before netifd) and once as S15sk-bridge on every boot after that.
#
# The wait is bounded: a board whose 9132 really does not come up still
# boots, it just comes up with the conduit alone, which is what the
# generation left and what the kernel accepts.
#
# WHY THE 7.3 LINE CARRIES ITS OWN COPY OF THIS FILE
#
# The shared copy (overlays/.../init.d/sk-bridge) is untouched and stays
# the 6.18 generation's.  That generation has no DSA ports in its LAN at
# all - its 9132 registers plain netdevs before the pivot, so the
# generation sees the jacks and never needs a repair.
#
# A build executes this inside the package root.  There is no network
# config to edit there, and this must not loop or the image build waits
# on it forever.
START=15
STOP=90

in_build() {
	[ -n "${IPKG_INSTROOT:-}" ] && return 0
	[ -n "${PKG_ROOT:-}" ] && return 0
	[ -n "${CI:-}" ] && return 0
	return 1
}

# The four panel jacks of this board: the ones that have a cable in them.
# lan0 is the jackless DSA port.  All five are DSA user ports and all five
# belong in the LAN bridge.
panel_jacks() {
	echo "lan1 lan2 lan3 lan4"
}

# Every DSA user port of the 9132.
dsa_user_ports() {
	echo "lan0 lan1 lan2 lan3 lan4"
}

# Wait for the 9132's DSA ports.  They are registered a couple of seconds
# into the boot and this script runs before that.
#
# 15 seconds is four times the measured delay, and the wait is only paid
# when the bridge really has none of them in it - on every boot after the
# first one it is not paid at all.
wait_for_dsa_user_ports() {
	n=0
	while [ "$n" -lt 15 ]; do
		for p in $(dsa_user_ports); do
			[ -e "/sys/class/net/$p" ] && return 0
		done
		sleep 1
		n=$((n + 1))
	done
	return 1
}

# Does this bridge hold any of the DSA user ports?
has_dsa_user_port() {
	for p in $(dsa_user_ports); do
		case " $1 " in
		*" $p "*) return 0 ;;
		esac
	done
	return 1
}

apply_bridge() {
	in_build && return 0
	command -v uci >/dev/null 2>&1 || return 0
	[ -s /etc/config/network ] || return 0

	i=0
	while uci -q get "network.@device[$i]" >/dev/null 2>&1; do
		typ=$(uci -q get "network.@device[$i].type")
		if [ "$typ" = bridge ]; then
			ports=$(uci -q get "network.@device[$i].ports")

			# THE DEGENERATE CASE: the bridge holds none of the DSA
			# user ports.  This is what the preinit-stage
			# generation leaves behind, and it holds the conduit
			# alone.
			if ! has_dsa_user_port "$ports"; then
				wait_for_dsa_user_ports
				for p in $(dsa_user_ports); do
					if [ -e "/sys/class/net/$p" ]; then
						uci add_list "network.@device[$i].ports=$p"
					fi
				done
				ports=$(uci -q get "network.@device[$i].ports")
			fi

			# THE CONDUIT MUST NOT BE IN THE BRIDGE.  A DSA
			# bridge holds either the conduit or the user
			# ports, and the kernel refuses a list that holds
			# both.  The generation puts the conduit there, so
			# it has to come out again.
			old=$(echo $ports)
			keep=""
			for p in $ports; do
				[ "$p" = lan-cpu0 ] && continue
				keep="$keep $p"
			done
			keep=$(echo $keep)
			if [ -n "$keep" ] && [ "$keep" != "$old" ]; then
				uci set "network.@device[$i].ports=$keep"
			fi
			break
		fi
		i=$((i + 1))
	done

	if ! uci -q get network.wan >/dev/null 2>&1; then
		uci set network.wan=interface
		uci set network.wan.device=eth0
		uci set network.wan.proto=dhcp
	fi
	uci commit network
}

start() {
	apply_bridge
}
